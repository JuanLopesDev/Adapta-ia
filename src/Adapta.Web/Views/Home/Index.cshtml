@{ ViewData["Title"] = "Início"; }
<div class="hero row align-items-center g-5">
    <section class="col-lg-6">
        <p class="categoria">Avaliação inclusiva</p>
        <h1>Uma questão,<br />mais clareza.</h1>
        <p class="lead">Um projeto para apoiar professores na adaptação de avaliações para estudantes com TEA ou dislexia, preservando o que cada questão pretende avaliar.</p>
        <a class="btn btn-primary rounded-pill px-4 py-2" asp-action="Guia">Conhecer o projeto <span aria-hidden="true">→</span></a>
    </section>
    <aside class="col-lg-6" aria-label="Exemplo ilustrativo de adaptação">
        <div class="folha">
            <p class="categoria">Exemplo ilustrativo · Ciências</p>
            <h2>O ciclo da água</h2>
            <h3>Enunciado original</h3>
            <p>Descreva a evaporação e a condensação, indicando onde cada processo ocorre no ciclo da água.</p>
            <hr />
            <h3>Enunciado em etapas</h3>
            <ol><li>Descreva a evaporação. Onde ela ocorre no ciclo da água?</li><li>Descreva a condensação. Onde ela ocorre nesse ciclo?</li></ol>
        </div>
    </aside>
</div>
