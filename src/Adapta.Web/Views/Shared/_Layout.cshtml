<!doctype html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] · Adapta</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
<a class="visually-hidden-focusable" href="#conteudo">Ir ao conteúdo</a>
<header><nav class="container shell" aria-label="Principal">
    <a class="marca" asp-controller="Home" asp-action="Index"><span aria-hidden="true">a</span> Adapta</a>
    <div class="d-flex align-items-center gap-3">
        <a class="guia-link" asp-controller="Home" asp-action="Guia">Guia</a>
        @if (User.Identity?.IsAuthenticated == true)
        {
            <a asp-controller="Conta" asp-action="Index">Minha conta</a>
            <form asp-controller="Conta" asp-action="Sair" method="post">
                <button class="btn btn-outline-secondary" type="submit">Sair</button>
            </form>
        }
        else
        {
            <a class="btn btn-primary" asp-controller="Conta" asp-action="Entrar">Entrar</a>
        }
    </div>
</nav></header>
<main id="conteudo" class="container" tabindex="-1">@RenderBody()</main>
<footer><div class="container">Adapta · Projeto de conclusão de curso</div></footer>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js" defer></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
